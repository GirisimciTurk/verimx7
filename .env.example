# =============================================================================
# Verimx7 — ortam değişkenleri örneği
#
# Kullanım:
#   cp .env.example .env.local        # yerel geliştirme
#   Üretimde değerleri barındırma sağlayıcısının ortam değişkeni panosuna girin.
#   .env, .env.local ve .env*.local repoya işlenmez (bkz. .gitignore).
#
# -----------------------------------------------------------------------------
# UYARI — TALEP TESLİM KANALI ZORUNLUDUR
#
# Aşağıdaki üç kanaldan EN AZ BİRİ yapılandırılmadan üretime çıkmayın:
#     1) RESEND_API_KEY + LEAD_TO_EMAIL   (e-posta)
#     2) LEAD_WEBHOOK_URL                 (CRM / Zapier / Make / n8n)
#     3) LEAD_LOG_DIR                     (kendi sunucunuzda dosyaya yazma)
#
# Hiçbiri yapılandırılmamışsa üretimde /api/basvuru ve /api/rapor uçları
# 503 döner; ziyaretçi forma "aldık" cevabı yerine doğrudan iletişim
# kanallarına yönlendirilir (başvuru formunda e-posta ve WhatsApp, rapor
# talebinde e-posta). Kanal tanımlı olduğu hâlde hiçbiri teslim edemezse yanıt
# 502 olur. Bu bilinçli bir tercihtir: talebi almış gibi yapıp hiçbir yere
# yazmamak, yapılabilecek en kötü hatadır.
# (Geliştirme ortamında kanal yoksa talep yalnızca sunucu konsoluna düşer ve
#  uç "ok" döner — bu yalnızca yerel kolaylıktır, teslim güvencesi değildir.)
# =============================================================================


# -----------------------------------------------------------------------------
# ZORUNLU — Sitenin kanonik adresi.
# Sondaki eğik çizgi olmadan, şema dahil yazın. lib/site.ts içindeki SITE_URL
# bu değerden okunur; metadataBase, canonical, Open Graph / Twitter kart
# adresleri, JSON-LD adresleri ve app/sitemap.ts + app/robots.ts çıktıları
# buradan üretilir.
# Yayına almadan önce mutlaka gerçek alan adına ayarlayın; ayarlanmazsa kod
# https://verimx7.com varsayılanına düşer ve yanlış alan adı indekslenebilir.
# Yerelde: http://localhost:3000
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://verimx7.com


# -----------------------------------------------------------------------------
# OPSİYONEL (e-posta kanalı için zorunlu) — Resend API anahtarı.
# https://resend.com üzerinden alınır. Talep e-postaları Resend REST API'sine
# doğrudan gönderilir, ek bir SDK bağımlılığı yoktur.
# Tek başına yetmez: LEAD_TO_EMAIL ile birlikte tanımlanmalıdır.
# Bu anahtar bir sırdır; repoya, istemci koduna veya panolara yazmayın.
# -----------------------------------------------------------------------------
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# OPSİYONEL (e-posta kanalı için zorunlu) — Taleplerin düşeceği adres(ler).
# Birden fazla alıcı için virgülle ayırın: satis@ornek.com, bilgi@ornek.com
# Yayına almadan önce buranın gerçekten okunan bir kutu olduğunu doğrulayın;
# kimsenin bakmadığı bir adres, kanalın hiç olmamasıyla aynı sonucu verir.
# -----------------------------------------------------------------------------
LEAD_TO_EMAIL=


# -----------------------------------------------------------------------------
# OPSİYONEL — Gönderen adresi. "Ad <adres@alanadi.com>" biçimi kabul edilir.
# Alan adının Resend'de DOĞRULANMIŞ olması gerekir (SPF/DKIM kayıtları).
# Boş bırakılırsa kod "Verimx7 <onboarding@resend.dev>" test göndericisine
# düşer — üretim için uygun değildir, teslim edilebilirliği düşüktür.
# Yayına almadan önce doldurun.
# Örnek: Verimx7 <talep@alanadiniz.com>
# -----------------------------------------------------------------------------
LEAD_FROM_EMAIL=


# -----------------------------------------------------------------------------
# OPSİYONEL — CRM / otomasyon webhook adresi (Zapier, Make, n8n, kendi API'niz).
# Talebin tamamı JSON gövde olarak POST edilir (alan listesi + ham veri +
# IP / user-agent / referer / zaman damgası). https kullanın.
# KVKK notu: bu uç, kişisel veriyi yurt dışına aktarabilecek bir kanaldır;
# hangi sağlayıcıya gittiğini aydınlatma metniyle tutarlı tutun.
# -----------------------------------------------------------------------------
LEAD_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# OPSİYONEL — Webhook doğrulama sırrı.
# Tanımlanırsa her istekte "X-Verimx7-Secret" başlığıyla gönderilir; alıcı uç
# bu değeri karşılaştırarak sahte talepleri eler. Uzun, rastgele bir dize
# kullanın (örn. `openssl rand -hex 32` çıktısı).
# -----------------------------------------------------------------------------
LEAD_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# OPSİYONEL — Talepleri sunucudaki bir dizine JSONL olarak yazar.
# Dosya adı: <dizin>/basvuru-YYYY-MM-DD.jsonl ve rapor-YYYY-MM-DD.jsonl
# YALNIZCA kendi sunucunuzda (VPS / konteyner) anlamlıdır. Vercel gibi
# sunucusuz ortamlarda dosya sistemi kalıcı değildir, veri kaybolur.
# Dizin kişisel veri içerir: web kökünün DIŞINDA tutun, erişim izinlerini
# daraltın (örn. chmod 700) ve yedek/imha politikanıza dahil edin.
# Örnek: /var/lib/verimx7/leads
# -----------------------------------------------------------------------------
LEAD_LOG_DIR=


# -----------------------------------------------------------------------------
# ÖNERİLİR — Ters vekil güveni.
# Hız sınırlayıcının istemci IP'sini hangi başlıktan okuyacağını belirler.
# Başlıklar istemci tarafından uydurulabildiği için kod, bu değişken
# ayarlanmadıkça hiçbirine güvenmez.
#   vercel      → x-vercel-forwarded-for
#   cloudflare  → cf-connecting-ip
#   1           → x-forwarded-for'un SAĞDAN 1. değeri (tek nginx/Caddy)
#   2           → sağdan 2. değer (iki vekil zinciri)
# Boş bırakılırsa hız sınırı kişi başına değil SİTE GENELİ tek kovaya düşer
# ve talep kaydındaki IP alanı "doğrulanmadı" yazar.
# -----------------------------------------------------------------------------
TRUST_PROXY=
